{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": ["@rainstormy/presets-web/typescript"],
	"compilerOptions": {
		"incremental": true,
		"lib": ["ES2025"],
		"module": "ESNext",
		"target": "ESNext",
		"tsBuildInfoFile": "node_modules/.cache/typescript/.tsbuildinfo",
		"types": ["node"]
	},
	"include": ["**/*.ts"],
	"exclude": ["dist/", "node_modules/"]
}
