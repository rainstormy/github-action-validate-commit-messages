{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@rainstormy/comet",
	"version": "2.0.0-alpha.0",
	"private": true,
	"license": "MIT",
	"author": "Steffen Diswal",
	"type": "module",
	"imports": {
		"#commits/*": "./src/domains/commits/*",
		"#configurations/*": "./src/domains/configurations/*",
		"#legacy-v1/*": "./src/legacy-v1/*",
		"#programs/*": "./src/domains/programs/*",
		"#rules/*": "./src/domains/rules/*",
		"#types/*": "./src/types/*",
		"#utilities/*": "./src/utilities/*"
	},
	"dependencies": {
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@rainstormy/presets-web": "catalog:",
		"@types/node": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.17.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.18.1",
			"onFail": "download"
		}
	}
}
